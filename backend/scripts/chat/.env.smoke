# scripts/chat/run_smoke.sh 가 이 파일을 export 해 FastAPI 에 주입한다.
# 로컬 docker-compose.smoke.yml 의 기본값과 맞춰져 있음.

HOST=127.0.0.1
# 호스트 0.0.0.0:8000 에 이미 바인딩된 다른 backend 컨테이너(ax-backend 등) 와 충돌 방지
PORT=8100

FRONTEND_URL=https://krip.site
LOCAL_FRONTEND_URL=http://localhost:3000

ENVIRONMENT=DEV
LOG_LEVEL=INFO
LOG_FORMAT=console
# 파일 출력 비활성화 — 기본값 `/backend/logs/...` 는 로컬에서 mkdir 실패한다
LOG_FILE_PATH=
LOG_ROTATION=100
LOG_RETENTION=7
LOG_COMPRESSION=gz

# 호스트 native postgres/mongod/redis 와 충돌 방지 — smoke 전용 고정 포트
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5532
POSTGRES_USER=cho
POSTGRES_PASSWORD=hyeonsang
POSTGRES_NAME=chohyeonsang

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27117
MONGODB_USER=cho
MONGODB_PASSWORD=hyeonsang
MONGODB_NAME=chohyeonsang

REDIS_HOST=127.0.0.1
REDIS_PORT=6479
REDIS_DB=0
REDIS_DB_DEDUPE=1

FANOUT_MODE=in_process
NODE_ID=smoke-test-node

# Phase 3 smoke — reconcile 루프 tick 을 1초로 줄여 dirty 처리가 수 초 내 관찰 가능하도록.
# 운영 기본은 300(5분), 테스트 전용 override.
CHAT_RECONCILE_INTERVAL_SEC=1

ACCESS_TOKEN=smoke-access-token
USER_LOGIN_JWT_SECRET_KEY=smoke-jwt-secret-key-for-local-testing
USER_LOGIN_JWT_ALGORITHM=HS256
USER_LOGIN_JWT_EXPIRATION_DAYS=1
USER_LOGIN_COOKIE_NAME=utk

# 실제 값은 불필요 — 기동만 하려면 비어있지 않으면 됨
GOOGLE_CLIENT_ID=smoke-google-id
GOOGLE_CLIENT_SECRET=smoke-google-secret
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
S3_ACCESS_KEY_ID=smoke
S3_SECRET_ACCESS_KEY=smoke
S3_REGION=kr-standard
S3_BUCKET_NAME=smoke
S3_ENDPOINT_URL=http://localhost
GOOGLE_GEMINI_API_KEY=smoke
