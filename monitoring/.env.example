# `cp monitoring/.env.example monitoring/.env` 후 실제 값을 입력한다.
# Makefile이 `--env-file monitoring/.env`로 모니터링 stack에 주입한다.
# backend 환경변수는 backend/.env에서 별도로 관리한다.

# ─── 환경 (Prometheus external_labels.env 자동 부착) ───
ENV=DEV

# ─── 노드 식별자 (Alloy Loki 라벨) ───
# 멀티 노드 진입 시 노드별로 다른 값. 단일 인스턴스 dev 는 default 유지.
NODE_ID=krip-backend

# ─── Grafana (admin 비번 강제) ───
GRAFANA_ADMIN_PASSWORD=changeme

# ─── 데이터스토어 자격증명 (exporter 가 사용) ───
# 메인 docker-compose.yml 의 PG / Mongo / Redis 비번과 동일해야 함.
# backend/.env와 중복되지만 exporter Compose substitution에 별도로 필요하다.
POSTGRES_USER=cho
POSTGRES_PASSWORD=hyeonsang
POSTGRES_NAME=chohyeonsang
MONGODB_USER=cho
MONGODB_PASSWORD=hyeonsang
